# .env.example
# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ---
DB_USER=postgres
DB_PASSWORD=securepassword
DB_NAME=vireel

# --- Auth (email/password + JWT) ---
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- OpenAI (highlight analysis + script generation) ---
OPENAI_API_KEY=

# --- Frontend ---
# Set this to the ORIGIN THE BROWSER LOADS THE FRONTEND FROM (not the backend's
# own port). nginx (see frontend/nginx.conf) proxies /api on that same origin
# through to the backend container internally, so the browser never makes a
# cross-origin request and no CORS configuration is needed. This is baked into
# the frontend bundle at Docker build time, so changing it requires rebuilding
# the frontend image.
#   Local dev (vite dev server):        http://localhost:5173
#   docker-compose (as shipped, :8080): http://localhost:8080
#   Production VPS/domain:              http://<your-ip-or-domain>:8080 (or https://your-domain)
VITE_API_URL=http://localhost:8080
